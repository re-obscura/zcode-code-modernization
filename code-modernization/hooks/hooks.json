{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.sh\" command",
            "timeout": 10,
            "statusMessage": "Counting usage"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.sh\" state",
            "timeout": 10,
            "statusMessage": "Counting usage"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.sh\" run",
            "timeout": 10,
            "statusMessage": "Counting usage"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.sh\" health",
            "timeout": 10,
            "statusMessage": "Counting usage"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/telemetry.sh\" failure",
            "timeout": 10,
            "statusMessage": "Counting usage"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/zcode/run-hook.sh\" xray",
            "timeout": 10,
            "statusMessage": "X-raying the read"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/zcode/run-hook.sh\" guard",
            "timeout": 5,
            "statusMessage": "Guarding the legacy source"
          }
        ]
      }
    ]
  }
}
